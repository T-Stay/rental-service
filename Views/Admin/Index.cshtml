@model IEnumerable<RentalService.Models.User>
@{
    ViewData["Title"] = "Admin Dashboard";
}
<h2 class="fw-bold mb-4 text-primary"><i class="fa-solid fa-gauge-high me-2"></i>Admin Dashboard</h2>
<div class="row g-4 mb-4">
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <i class="fa-solid fa-users fa-2x text-primary mb-2"></i>
                <h5 class="card-title">Quản lý người dùng</h5>
                <a href="@Url.Action("UserList", "Admin")" class="btn btn-outline-primary w-100 mt-2">Xem chi tiết</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <i class="fa-solid fa-bullhorn fa-2x text-warning mb-2"></i>
                <h5 class="card-title">Duyệt bài quảng cáo</h5>
                <a href="@Url.Action("AdPostsToApprove", "Admin")" class="btn btn-outline-warning w-100 mt-2">Duyệt ngay</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <i class="fa-solid fa-building fa-2x text-success mb-2"></i>
                <h5 class="card-title">Quản lý tòa nhà</h5>
                <a href="@Url.Action("Index", "HostBuildings")" class="btn btn-outline-success w-100 mt-2">Xem chi tiết</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 text-center h-100">
            <div class="card-body">
                <i class="fa-solid fa-chart-line fa-2x text-info mb-2"></i>
                <h5 class="card-title">Thống kê hệ thống</h5>
                <a href="@Url.Action("Statistics", "Admin")" class="btn btn-outline-info w-100 mt-2">Xem thống kê</a>
            </div>
        </div>
    </div>
</div>
<hr />

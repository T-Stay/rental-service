<!-- Thêm CSS cho dashboard đẹp hơn nếu cần -->
<style>
    .card .fa-2x { font-size: 2.2rem; }
    .card-title { font-size: 1.1rem; font-weight: 600; }
    .card { transition: box-shadow .2s; }

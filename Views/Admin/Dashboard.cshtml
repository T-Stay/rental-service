@{
    ViewData["Title"] = "Admin Dashboard";
    var stats = Model;
}
<div class="container mt-4">
    <h2 class="fw-bold mb-4 text-primary"><i class="fa-solid fa-gauge-high me-2"></i>Admin Dashboard</h2>
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-primary">
                <div class="card-body text-center">
                    <div class="fs-2 text-primary"><i class="fa-solid fa-users"></i></div>
                    <div class="fw-bold fs-4">@stats.totalUsers</div>
                    <div class="text-muted">Tổng người dùng</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-success">
                <div class="card-body text-center">
                    <div class="fs-2 text-success"><i class="fa-solid fa-user-tie"></i></div>
                    <div class="fw-bold fs-4">@stats.totalHosts</div>
                    <div class="text-muted">Chủ nhà</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-info">
                <div class="card-body text-center">
                    <div class="fs-2 text-info"><i class="fa-solid fa-user"></i></div>
                    <div class="fw-bold fs-4">@stats.totalCustomers</div>
                    <div class="text-muted">Khách thuê</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-warning">
                <div class="card-body text-center">
                    <div class="fs-2 text-warning"><i class="fa-solid fa-user-shield"></i></div>
                    <div class="fw-bold fs-4">@stats.totalAdmins</div>
                    <div class="text-muted">Admin</div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-secondary">
                <div class="card-body text-center">
                    <div class="fs-2 text-secondary"><i class="fa-solid fa-building"></i></div>
                    <div class="fw-bold fs-4">@stats.totalRooms</div>
                    <div class="text-muted">Phòng</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-primary">
                <div class="card-body text-center">
                    <div class="fs-2 text-primary"><i class="fa-solid fa-bullhorn"></i></div>
                    <div class="fw-bold fs-4">@stats.totalAdPosts</div>
                    <div class="text-muted">Bài quảng cáo</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-danger">
                <div class="card-body text-center">
                    <div class="fs-2 text-danger"><i class="fa-solid fa-clock"></i></div>
                    <div class="fw-bold fs-4">@stats.totalPendingRooms</div>
                    <div class="text-muted">Phòng chờ duyệt</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card shadow-sm border-warning">
                <div class="card-body text-center">
                    <div class="fs-2 text-warning"><i class="fa-solid fa-clock"></i></div>
                    <div class="fw-bold fs-4">@stats.totalPendingAds</div>
                    <div class="text-muted">QC chờ duyệt</div>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-primary"><i class="fa-solid fa-users"></i> Quản lý người dùng</a>
        <a href="@Url.Action("RoomsToApprove", "Admin")" class="btn btn-outline-warning"><i class="fa-solid fa-building"></i> Duyệt phòng</a>
        <a href="@Url.Action("AdPostsToApprove", "Admin")" class="btn btn-outline-info"><i class="fa-solid fa-bullhorn"></i> Duyệt quảng cáo</a>
    </div>
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white fw-bold">
            <i class="fa-solid fa-users"></i> Người dùng mới nhất
        </div>
        <div class="card-body p-0">
            @await Html.PartialAsync("_AdminUserTablePartial")
        </div>
    </div>
</div>
<style>
    .card .fs-2 { min-height: 2.5em; }
</style>

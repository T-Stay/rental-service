@{
    ViewData["Title"] = "Thống kê hệ thống";
}
<!-- Navigation bar for admin views -->
<nav class="mb-4">
    <ul class="nav nav-pills gap-2">
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" href="@Url.Action("Index", "Admin")">
                <i class="fa-solid fa-gauge"></i> Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "UserList" ? "active" : "")" href="@Url.Action("UserList", "Admin")">
                <i class="fa-solid fa-users"></i> Người dùng
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Statistics" ? "active" : "")" href="@Url.Action("Statistics", "Admin")">
                <i class="fa-solid fa-chart-line"></i> Thống kê
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "RoomsToApprove" ? "active" : "")" href="@Url.Action("RoomsToApprove", "Admin")">
                <i class="fa-solid fa-door-open"></i> Duyệt phòng
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AdPostsToApprove" ? "active" : "")" href="@Url.Action("AdPostsToApprove", "Admin")">
                <i class="fa-solid fa-bullhorn"></i> Duyệt quảng cáo
            </a>
        </li>
    </ul>
</nav>
<h2 class="fw-bold mb-4 text-info"><i class="fa-solid fa-chart-line me-2"></i>Thống kê hệ thống</h2>
<div class="row g-4 mb-4">
    <div class="col-md-4 col-6">
        <div class="card bg-dark text-white text-center h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">@(ViewBag.TotalUsers != null ? ViewBag.TotalUsers : "-")</div>
                <div>Người dùng</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-6">
        <div class="card bg-danger text-white text-center h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">@(ViewBag.TotalRooms != null ? ViewBag.TotalRooms : "-")</div>
                <div>Phòng cho thuê</div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-6">
        <div class="card bg-secondary text-white text-center h-100">
            <div class="card-body">
                <div class="fs-3 fw-bold">@(ViewBag.TotalBuildings != null ? ViewBag.TotalBuildings : "-")</div>
                <div>Tòa nhà</div>
            </div>
        </div>
    </div>
</div>
<hr />
<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <label class="fw-bold me-2 mb-0">Thời gian:</label>
    <select id="timeUnit" class="form-select w-auto">
        <option value="month" selected>Tháng</option>
        <option value="week">Tuần</option>
        <option value="day">Ngày</option>
        <option value="year">Năm</option>
    </select>
    <input type="number" id="timeRange" class="form-control w-auto" min="1" max="36" value="12" style="width:90px;" />
    <span class="ms-2">Số lượng mốc</span>
</div>
<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white fw-bold">Tăng trưởng người dùng theo thời gian</div>
            <div class="card-body">
                <canvas id="userGrowthChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-danger text-white fw-bold">Tỉ lệ vai trò người dùng</div>
            <div class="card-body d-flex justify-content-center">
                <div style="max-width:320px;width:100%">
                    <canvas id="userRolePie" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white fw-bold">Số lượng gói quảng cáo được mua theo thời gian</div>
            <div class="card-body">
                <canvas id="adPackageGrowthChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-dark fw-bold">Tỉ lệ các loại gói quảng cáo đã mua</div>
            <div class="card-body d-flex justify-content-center">
                <div style="max-width:320px;width:100%">
                    <canvas id="adPackagePieChart" height="120"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-warning text-dark fw-bold">Số lượng bài quảng cáo theo thời gian</div>
            <div class="card-body">
                <canvas id="adPostChart" height="120"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white fw-bold">Số lượng phòng mới theo thời gian</div>
            <div class="card-body">
                <canvas id="roomGrowthChart" height="120"></canvas>
            </div>
        </div>
    </div>
    
</div>
<div id="charts-loading" style="display:none;position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:9999;background:rgba(255,255,255,0.7);align-items:center;justify-content:center;">
    <div class="spinner-border text-primary" style="width:4rem;height:4rem;" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let userGrowthChart, userRolePie, adPostChart, roomGrowthChart, adPackageGrowthChart, adPackagePieChart;
        const loadingEl = document.getElementById('charts-loading');
        async function fetchAndRenderAll(unit, range) {
            loadingEl.style.display = 'flex';
            try {
                // Fetch growth data
                const growthRes = await fetch(`/api/admin/statistics/growth?unit=${unit}&range=${range}`);
                const growth = await growthRes.json();
                // Fetch role data
                const roleRes = await fetch(`/api/admin/statistics/roles`);
                const role = await roleRes.json();
                // Fetch ad package growth
                const adPkgGrowthRes = await fetch(`/api/admin/statistics/adpackages/growth?unit=${unit}&range=${range}`);
                const adPkgGrowth = await adPkgGrowthRes.json();
                // Fetch ad package ratio
                const adPkgRatioRes = await fetch(`/api/admin/statistics/adpackages/ratio`);
                const adPkgRatio = await adPkgRatioRes.json();
                // Render charts
                renderCharts(growth.userGrowth, role, growth.adPostGrowth, growth.roomGrowth, adPkgGrowth, adPkgRatio);
            } finally {
                loadingEl.style.display = 'none';
            }
        }
        function getFakeAdPostData(labels, unit) {
            function seededRandom(seed) {
                let x = Math.sin(seed) * 10000;
                return x - Math.floor(x);
            }
            function parseLabel(label, unit) {
                if (unit === 'day') {
                    let parts = label.split('/');
                    if (parts.length === 3) {
                        let [d, m, y] = parts;
                        return new Date(parseInt(y), parseInt(m) - 1, parseInt(d));
                    } else if (parts.length === 2) {
                        let [d, m] = parts;
                        let year = new Date().getFullYear();
                        return new Date(year, parseInt(m) - 1, parseInt(d));
                    }
                } else if (unit === 'month') {
                    let [m, y] = label.split('/');
                    return new Date(parseInt(y), parseInt(m) - 1, 1);
                } else if (unit === 'year') {
                    return new Date(parseInt(label), 0, 1);
                } else if (unit === 'week') {
                    let match = label.match(/Tuần (\d+)\/(\d+)/);
                    if (match) {
                        let week = parseInt(match[1]);
                        let year = parseInt(match[2]);
                        let d = new Date(year, 0, 1);
                        let day = d.getDay();
                        let diff = (day <= 1 ? 1 - day : 8 - day);
                        d.setDate(d.getDate() + diff + (week - 1) * 7);
                        return d;
                    }
                }
                return null;
            }
            const FAKE_START = new Date(2025, 5, 21); // June 21, 2025
            let fakeData = [];
            for (let i = 0; i < labels.length; i++) {
                let label = labels[i];
                let d = parseLabel(label, unit);
                let sum = 0;
                if (!d || d < FAKE_START) { fakeData.push(0); continue; }
                if (unit === 'day') {
                    if (d < FAKE_START) {
                        sum = 0;
                    } else if (d.getFullYear() === 2025 && d.getMonth() === 5) {
                        let v = 4 + Math.floor(seededRandom(d.getTime()) * 3) - 1;
                        sum = v;
                    } else if (d >= new Date(2025, 6, 6)) {
                        let v = 9 + Math.floor(seededRandom(d.getTime()) * 5) - 2;
                        sum = v;
                    } else if (d.getFullYear() === 2025 && d.getMonth() === 6) {
                        let v = 6 + Math.floor(seededRandom(d.getTime()) * 5) - 2;
                        sum = v;
                    }
                } else if (unit === 'month') {
                    let month = d.getMonth();
                    let year = d.getFullYear();
                    let days = new Date(year, month + 1, 0).getDate();
                    for (let day = 1; day <= days; day++) {
                        let cur = new Date(year, month, day);
                        if (cur < FAKE_START) continue;
                        let v = 0;
                        if (cur.getFullYear() === 2025 && cur.getMonth() === 5) {
                            v = 4 + Math.floor(seededRandom(cur.getTime()) * 3) - 1;
                        } else if (cur >= new Date(2025, 6, 6)) {
                            v = 9 + Math.floor(seededRandom(cur.getTime()) * 5) - 2;
                        } else if (cur.getFullYear() === 2025 && cur.getMonth() === 6) {
                            v = 6 + Math.floor(seededRandom(cur.getTime()) * 5) - 2;
                        }
                        sum += v;
                    }
                } else if (unit === 'year') {
                    let year = d.getFullYear();
                    let start = new Date(year, 0, 1);
                    let end = new Date(year + 1, 0, 1);
                    for (let cur = new Date(start); cur < end; cur.setDate(cur.getDate() + 1)) {
                        if (cur < FAKE_START) continue;
                        let v = 0;
                        if (cur.getFullYear() === 2025 && cur.getMonth() === 5) {
                            v = 4 + Math.floor(seededRandom(cur.getTime()) * 3) - 1;
                        } else if (cur >= new Date(2025, 6, 6)) {
                            v = 9 + Math.floor(seededRandom(cur.getTime()) * 5) - 2;
                        } else if (cur.getFullYear() === 2025 && cur.getMonth() === 6) {
                            v = 6 + Math.floor(seededRandom(cur.getTime()) * 5) - 2;
                        }
                        sum += v;
                    }
                } else if (unit === 'week') {
                    let weekStart = new Date(d);
                    for (let j = 0; j < 7; j++) {
                        let cur = new Date(weekStart);
                        cur.setDate(cur.getDate() + j);
                        if (cur < FAKE_START) continue;
                        let v = 0;
                        if (cur.getFullYear() === 2025 && cur.getMonth() === 5) {
                            v = 4 + Math.floor(seededRandom(cur.getTime()) * 3) - 1;
                        } else if (cur >= new Date(2025, 6, 6)) {
                            v = 9 + Math.floor(seededRandom(cur.getTime()) * 5) - 2;
                        } else if (cur.getFullYear() === 2025 && cur.getMonth() === 6) {
                            v = 6 + Math.floor(seededRandom(cur.getTime()) * 5) - 2;
                        }
                        sum += v;
                    }
                }
                fakeData.push(sum);
            }
            return fakeData;
        }
        function getFakeRoomGrowthData(labels, unit) {
            // Fake logic giống adPost: tháng 6/2025: 2-4, từ 6/7/2025: 5-8, đầu 7: 3-6
            function seededRandom(seed) {
                let x = Math.sin(seed + 2025) * 10000;
                return x - Math.floor(x);
            }
            function parseLabel(label, unit) {
                if (unit === 'day') {
                    let parts = label.split('/');
                    if (parts.length === 3) {
                        let [d, m, y] = parts;
                        return new Date(parseInt(y), parseInt(m) - 1, parseInt(d));
                    } else if (parts.length === 2) {
                        let [d, m] = parts;
                        let year = new Date().getFullYear();
                        return new Date(year, parseInt(m) - 1, parseInt(d));
                    }
                } else if (unit === 'month') {
                    let [m, y] = label.split('/');
                    return new Date(parseInt(y), parseInt(m) - 1, 1);
                } else if (unit === 'year') {
                    return new Date(parseInt(label), 0, 1);
                } else if (unit === 'week') {
                    let match = label.match(/Tuần (\d+)\/(\d+)/);
                    if (match) {
                        let week = parseInt(match[1]);
                        let year = parseInt(match[2]);
                        let d = new Date(year, 0, 1);
                        let day = d.getDay();
                        let diff = (day <= 1 ? 1 - day : 8 - day);
                        d.setDate(d.getDate() + diff + (week - 1) * 7);
                        return d;
                    }
                }
                return null;
            }
            const FAKE_START = new Date(2025, 5, 20); // 21/6/2025
            let fakeData = [];
            for (let i = 0; i < labels.length; i++) {
                let label = labels[i];
                let d = parseLabel(label, unit);
                let sum = 0;
                if (!d || d < FAKE_START) { fakeData.push(0); continue; }
                if (unit === 'day') {
                    if (d.getFullYear() === 2025 && d.getMonth() === 5) {
                        let v = 3 + Math.floor(seededRandom(d.getTime()) * 2) - 1; // 2-4
                        sum = v;
                    } else if (d >= new Date(2025, 6, 6)) {
                        let v = 6 + Math.floor(seededRandom(d.getTime()) * 4) - 1; // 5-8
                        sum = v;
                    } else if (d.getFullYear() === 2025 && d.getMonth() === 6) {
                        let v = 4 + Math.floor(seededRandom(d.getTime()) * 3) - 1; // 3-6
                        sum = v;
                    }
                } else if (unit === 'month') {
                    let month = d.getMonth();
                    let year = d.getFullYear();
                    let days = new Date(year, month + 1, 0).getDate();
                    for (let day = 1; day <= days; day++) {
                        let cur = new Date(year, month, day);
                        if (cur < FAKE_START) continue;
                        let v = 0;
                        if (cur.getFullYear() === 2025 && cur.getMonth() === 5) {
                            v = 3 + Math.floor(seededRandom(cur.getTime()) * 2) - 1;
                        } else if (cur >= new Date(2025, 6, 6)) {
                            v = 6 + Math.floor(seededRandom(cur.getTime()) * 4) - 1;
                        } else if (cur.getFullYear() === 2025 && cur.getMonth() === 6) {
                            v = 4 + Math.floor(seededRandom(cur.getTime()) * 3) - 1;
                        }
                        sum += v;
                    }
                } else if (unit === 'year') {
                    let year = d.getFullYear();
                    let start = new Date(year, 0, 1);
                    let end = new Date(year + 1, 0, 1);
                    for (let cur = new Date(start); cur < end; cur.setDate(cur.getDate() + 1)) {
                        if (cur < FAKE_START) continue;
                        let v = 0;
                        if (cur.getFullYear() === 2025 && cur.getMonth() === 5) {
                            v = 3 + Math.floor(seededRandom(cur.getTime()) * 2) - 1;
                        } else if (cur >= new Date(2025, 6, 6)) {
                            v = 6 + Math.floor(seededRandom(cur.getTime()) * 4) - 1;
                        } else if (cur.getFullYear() === 2025 && cur.getMonth() === 6) {
                            v = 4 + Math.floor(seededRandom(cur.getTime()) * 3) - 1;
                        }
                        sum += v;
                    }
                } else if (unit === 'week') {
                    let weekStart = new Date(d);
                    for (let j = 0; j < 7; j++) {
                        let cur = new Date(weekStart);
                        cur.setDate(cur.getDate() + j);
                        if (cur < FAKE_START) continue;
                        let v = 0;
                        if (cur.getFullYear() === 2025 && cur.getMonth() === 5) {
                            v = 3 + Math.floor(seededRandom(cur.getTime()) * 2) - 1;
                        } else if (cur >= new Date(2025, 6, 6)) {
                            v = 6 + Math.floor(seededRandom(cur.getTime()) * 4) - 1;
                        } else if (cur.getFullYear() === 2025 && cur.getMonth() === 6) {
                            v = 4 + Math.floor(seededRandom(cur.getTime()) * 3) - 1;
                        }
                        sum += v;
                    }
                }
                fakeData.push(sum);
            }
            return fakeData;
        }
        function renderCharts(userGrowth, userRole, adPost, roomGrowth, adPkgGrowth, adPkgRatio) {
            // Fake adPost data (phải cộng trước khi render chart)
            const unit = document.getElementById('timeUnit').value;
            const fakeAdPost = getFakeAdPostData(adPost.labels, unit);
            const adPostDataFinal = adPost.data.map((v, i) => v + fakeAdPost[i]);
            // Fake roomGrowth data
            const fakeRoomGrowth = getFakeRoomGrowthData(roomGrowth.labels, unit);
            const roomGrowthDataFinal = roomGrowth.data.map((v, i) => v + fakeRoomGrowth[i]);
            console.log('[FAKE-DEBUG] adPost.data (real):', adPost.data);
            console.log('[FAKE-DEBUG] fakeAdPost:', fakeAdPost);
            console.log('[FAKE-DEBUG] adPostDataFinal:', adPostDataFinal);
            if (userGrowthChart) userGrowthChart.destroy();
            if (userRolePie) userRolePie.destroy();
            if (adPostChart) adPostChart.destroy();
            if (roomGrowthChart) roomGrowthChart.destroy();
            if (adPackageGrowthChart) adPackageGrowthChart.destroy();
            if (adPackagePieChart) adPackagePieChart.destroy();
            userGrowthChart = new Chart(document.getElementById('userGrowthChart'), {
                type: 'line',
                data: {
                    labels: userGrowth.labels,
                    datasets: [{
                        label: 'Người dùng mới',
                        data: userGrowth.data,
                        borderColor: '#212529',
                        backgroundColor: 'rgba(33,37,41,0.1)',
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {responsive: true, plugins: {legend: {display: false}}}
            });
            userRolePie = new Chart(document.getElementById('userRolePie'), {
                type: 'doughnut',
                data: {
                    labels: userRole.labels,
                    datasets: [{
                        data: userRole.data,
                        backgroundColor: ['#212529', '#dc3545', '#ffc107', '#198754', '#0dcaf0']
                    }]
                },
                options: {responsive: true, plugins: {legend: {position: 'bottom'}}, cutout: '70%'}
            });
            adPostChart = new Chart(document.getElementById('adPostChart'), {
                type: 'bar',
                data: {
                    labels: adPost.labels,
                    datasets: [{
                        label: 'Bài quảng cáo',
                        data: adPostDataFinal,
                        backgroundColor: '#dc3545'
                    }]
                },
                options: {responsive: true, plugins: {legend: {display: false}}}
            });
            roomGrowthChart = new Chart(document.getElementById('roomGrowthChart'), {
                type: 'bar',
                data: {
                    labels: roomGrowth.labels,
                    datasets: [{
                        label: 'Phòng mới',
                        data: roomGrowthDataFinal,
                        backgroundColor: '#198754'
                    }]
                },
                options: {responsive: true, plugins: {legend: {display: false}}}
            });
            // Màu sắc cho các loại gói
            const pkgColors = ['#6c757d', '#b87333', '#bfc1c2', '#ffd700', '#00bcd4'];
            // Biểu đồ line: Số lượng gói được mua theo thời gian (mỗi loại 1 màu)
            adPackageGrowthChart = new Chart(document.getElementById('adPackageGrowthChart'), {
                type: 'line',
                data: {
                    labels: adPkgGrowth.labels,
                    datasets: adPkgGrowth.datasets.map((ds, idx) => ({
                        label: ds.label,
                        data: ds.data,
                        borderColor: pkgColors[idx % pkgColors.length],
                        backgroundColor: pkgColors[idx % pkgColors.length] + '33', // màu nhạt cho fill
                        fill: false,
                        tension: 0.3,
                        pointRadius: 3,
                        borderWidth: 2
                    }))
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } },
                    scales: { x: { display: true }, y: { beginAtZero: true } }
                }
            });
            // Biểu đồ doughnut: Tỉ lệ các loại gói đã mua
            adPackagePieChart = new Chart(document.getElementById('adPackagePieChart'), {
                type: 'doughnut',
                data: {
                    labels: adPkgRatio.labels,
                    datasets: [{
                        data: adPkgRatio.data,
                        backgroundColor: pkgColors
                    }]
                },
                options: { responsive: true, plugins: { legend: { position: 'bottom' } }, cutout: '70%' }
            });
        }
        // Khởi tạo lần đầu
        fetchAndRenderAll('month', 12);
        // Xử lý filter thời gian
        document.getElementById('timeUnit').onchange = document.getElementById('timeRange').onchange = function() {
            const unit = document.getElementById('timeUnit').value;
            const range = parseInt(document.getElementById('timeRange').value) || 12;
            fetchAndRenderAll(unit, range);
        };
    </script>
}
<style>
    .card-header { font-size: 1.1rem; }
    .card { border-radius: 1rem; }
    .card .fw-bold { font-size: 1.3rem; }
    #userRolePie { max-width: 320px; margin: 0 auto; }
</style>

    /* ĐÃ XÓA: .bg-gradient-silver, .bg-gradient-diamond, .bg-gradient-gold, .bg-gradient-bronze để không override hiệu ứng động từ file CSS ngoài */
</style>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var sidebar = document.getElementById('adPostSidebarWrapper');
        if (!sidebar) return;
        var origOffset = sidebar.getBoundingClientRect().top + window.scrollY;
        var origWidth = sidebar.offsetWidth;
        function stickSidebar() {
            var scrollY = window.scrollY || window.pageYOffset;
            var viewportHeight = window.innerHeight;
            var sidebarHeight = sidebar.offsetHeight;
            var stopAt = document.body.scrollHeight - viewportHeight - 40;
            if (scrollY > origOffset - 20 && scrollY < stopAt) {
                sidebar.style.position = 'fixed';
                sidebar.style.top = '20px';
                sidebar.style.width = origWidth + 'px';
                sidebar.style.zIndex = 100;
            } else {
                sidebar.style.position = '';
                sidebar.style.top = '';
                sidebar.style.width = '';
                sidebar.style.zIndex = '';
            }
        }
        window.addEventListener('scroll', stickSidebar);
        window.addEventListener('resize', function() {
            sidebar.style.width = sidebar.parentElement.offsetWidth + 'px';
        });
    });
</script>

@model IEnumerable<RentalService.Models.AdPost>
@{
    ViewData["Title"] = "Trang Chủ";
    var kimCuongAds = Model?.Where(ad => ad.PackageType == RentalService.Models.AdPackageType.KimCuong).ToList() ?? new List<RentalService.Models.AdPost>();
    var vangAds = Model?.Where(ad => ad.PackageType == RentalService.Models.AdPackageType.Vang).ToList() ?? new List<RentalService.Models.AdPost>();
    var bacAds = Model?.Where(ad => ad.PackageType == RentalService.Models.AdPackageType.Bac).ToList() ?? new List<RentalService.Models.AdPost>();
    var dongAds = Model?.Where(ad => ad.PackageType == RentalService.Models.AdPackageType.Dong || ad.PackageType == RentalService.Models.AdPackageType.Free).ToList() ?? new List<RentalService.Models.AdPost>();
    var search = ViewBag.Search as string;
}
@if (!string.IsNullOrWhiteSpace(search))
{
    <div class="alert alert-info mb-4 d-flex align-items-center justify-content-between flex-wrap">
        <span>Đang lọc các quảng cáo liên quan đến: <b>@search</b></span>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary btn-sm ms-3 mt-2 mt-md-0">Bỏ lọc</a>
    </div>
}
@if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(Context.Request.Query["minPrice"]) || !string.IsNullOrEmpty(Context.Request.Query["maxPrice"]) || !string.IsNullOrEmpty(Context.Request.Query["minArea"]) || !string.IsNullOrEmpty(Context.Request.Query["maxArea"]) || !string.IsNullOrEmpty(Context.Request.Query["amenities"]) || !string.IsNullOrEmpty(Context.Request.Query["sort"]) || !string.IsNullOrEmpty(Context.Request.Query["centerLat"]) || !string.IsNullOrEmpty(Context.Request.Query["centerLng"]) || !string.IsNullOrEmpty(Context.Request.Query["radius"]))
{
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var postList = document.getElementById('ad-post-list-anchor');
        if (postList) {
            postList.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
    </script>
}
<div class="container mt-1">
     <!-- Hero Section -->
    @if (string.IsNullOrWhiteSpace(search))
    {
        <div class="homepage-hero mb-5 p-4 rounded-4 shadow-sm bg-hero-light text-primary">
            <div class="row align-items-center g-4">
                <div class="col-12">
                    <h1 class="display-2 fw-bolder mb-3 text-primary text-center text-md-start"><i class="fa fa-home me-2"></i>Trọ Tốt</h1>
                    <p class="lead mb-4 text-secondary fs-3 fw-semibold text-center text-md-start">Nền tảng kết nối thuê & cho thuê phòng trọ, căn hộ, nhà nguyên căn nhanh chóng, uy tín và tiện lợi.</p>
                    <div class="row g-4 justify-content-center justify-content-md-start">
                        <div class="col-12 col-md-4">
                            <div class="cta-box p-5 rounded-4 bg-white border h-100 d-flex flex-column align-items-start">
                                <div class="mb-2 fs-3 fw-bold text-primary"><i class="fa fa-search-location fa-xl text-info me-2"></i>Bạn là khách?</div>
                                <div class="mb-3 fs-5 cta-desc-sm text-secondary">Khám phá hàng ngàn phòng trọ, căn hộ phù hợp nhu cầu của bạn.</div>
                                <a href="@Url.Action("Index", "Rooms")" class="btn btn-outline-primary btn-lg w-100 fw-bold py-3 fs-5"><i class="fa fa-search me-1"></i>Tìm phòng ngay</a>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="cta-box p-5 rounded-4 bg-white border h-100 d-flex flex-column align-items-start">
                                <div class="mb-2 fs-3 fw-bold text-success"><i class="fa fa-user-tie fa-xl text-success me-2"></i>Bạn là chủ nhà?</div>
                                <div class="mb-3 fs-5 cta-desc-sm text-secondary">Đăng phòng cho thuê miễn phí, tiếp cận hàng ngàn khách thuê tiềm năng.</div>
                                <a href="@Url.Action("Create", "HostRooms")" class="btn btn-outline-success btn-lg w-100 fw-bold py-3 fs-5"><i class="fa fa-plus-circle me-1"></i>Đăng phòng ngay</a>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="cta-box p-5 rounded-4 bg-white border h-100 d-flex flex-column align-items-start">
                                <div class="mb-2 fs-3 fw-bold text-danger"><i class="fa fa-video fa-xl text-danger me-2"></i>Hướng Dẫn</div>
                                <div class="mb-3 fs-5 cta-desc-sm text-secondary">Xem video hướng dẫn sử dụng nền tảng nhanh chóng, dễ hiểu.</div>
                                <a href="https://drive.google.com/drive/folders/1uCQQqT4Bh3MGg4RvMVPbFwGhTUY0CebY?usp=sharing" target="_blank" rel="noopener" class="btn btn-outline-danger btn-lg w-100 fw-bold py-3 fs-5"><i class="fa fa-play-circle me-1"></i>Xem video</a>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-3 flex-wrap mt-4 justify-content-center justify-content-md-start">
                        <span class="badge bg-info bg-opacity-10 text-primary fw-semibold px-4 py-2 fs-6"><i class="fa fa-bolt me-1"></i> Đăng phòng miễn phí</span>
                        <span class="badge bg-info bg-opacity-10 text-primary fw-semibold px-4 py-2 fs-6"><i class="fa fa-check-circle me-1"></i> Tin xác thực</span>
                        <span class="badge bg-info bg-opacity-10 text-primary fw-semibold px-4 py-2 fs-6"><i class="fa fa-users me-1"></i> Hỗ trợ 24/7</span>
                        <span class="badge bg-info bg-opacity-10 text-primary fw-semibold px-4 py-2 fs-6"><i class="fa fa-fire me-1"></i> Ưu đãi hấp dẫn</span>
                        <span class="badge bg-info bg-opacity-10 text-primary fw-semibold px-4 py-2 fs-6"><i class="fa fa-star me-1"></i> Chủ nhà uy tín</span>
                        <span class="badge bg-info bg-opacity-10 text-primary fw-semibold px-4 py-2 fs-6"><i class="fa fa-shield-alt me-1"></i> Bảo mật thông tin</span>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="row">
        <div class="col-md-9">
            <span id="ad-post-list-anchor"></span>
            @if (!Model.Any())
            {
                <div class="alert alert-info mt-4">Không có quảng cáo/phòng nào phù hợp với bộ lọc của bạn. Hãy thử lại.</div>
            }
            else
            {
                <h2 class="mb-4">Bài viết đề xuất</h2>
                <!-- Kim cương + Vàng: mỗi row 2 col-md-6, trộn chung, ưu tiên kim cương lên trước -->
                <div class="mb-5">
                    @{
                        var topAds = kimCuongAds.Concat(vangAds).ToList();
                    }
                    @for (int i = 0; i < topAds.Count; i += 2)
                    {
                        <div class="row mb-4">
                            @for (int j = i; j < Math.Min(i + 2, topAds.Count); j++)
                            {
                                var ad = topAds[j];
                                var images = !string.IsNullOrEmpty(ad.ImageUrls) ? ad.ImageUrls.Split(',') : new string[0];
                                var activeRooms = ad.Rooms?.Where(r => r.Status == RentalService.Models.RoomStatus.Active).ToList() ?? new List<RentalService.Models.Room>();
                                var minPrice = activeRooms.Any() ? activeRooms.Min(r => r.Price) : 0;
                                var maxPrice = activeRooms.Any() ? activeRooms.Max(r => r.Price) : 0;
                                var isDiamond = ad.PackageType == RentalService.Models.AdPackageType.KimCuong;
                                var isGold = ad.PackageType == RentalService.Models.AdPackageType.Vang;
                                // --- FAKE LOGIC ---
                                int hash = ad.Id.GetHashCode();
                                int fakeView = ad.ViewCount;
                                DateTime fakeDate = DateTime.Today;
                                if (ad.CreatedAt.Date < DateTime.Today) {
                                    // Fake ngày: hôm qua, hôm kia, hoặc 3 ngày trước (dựa vào hash)
                                    int daysAgo = 1 + Math.Abs(hash % 3); // 1, 2, hoặc 3
                                    fakeDate = DateTime.Today.AddDays(-daysAgo);
                                    // Tỉ lệ lượt xem theo loại gói
                                    int baseView = 0;
                                    if (isDiamond) baseView = 300;
                                    else if (isGold) baseView = 180;
                                    else baseView = 100;
                                    fakeView = baseView + Math.Abs(hash % (baseView / 2)) + ((hash >> 3) % (baseView / 4));
                                }
                                <div class="col-md-6 col-lg-6 mb-3">
                                    <a href="@Url.Action("Details", "AdPosts", new { id = ad.Id })" class="ad-card-link">
                                        <div class="card @(isDiamond ? "diamond-ad-card" : "gold-ad-card") position-relative">
                                            <div class="@(isDiamond ? "diamond-img-wrap" : "gold-img-wrap")">
                                                @if (images.Length > 0 && !string.IsNullOrEmpty(images[0]))
                                                {
                                                    <img src="@images[0]" class="@(isDiamond ? "diamond-img-demo" : "gold-img-demo") img-fluid" alt="Ad Image" onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                                }
                                                else
                                                {
                                                    <img src="/images/no-image.png" class="@(isDiamond ? "diamond-img-demo" : "gold-img-demo") img-fluid" alt="No Image" />
                                                }
                                            </div>
                                            <div class="ad-meta-below-img px-3 py-1">
                                                <span class="me-3"><i class="fa fa-eye me-1"></i>@fakeView lượt xem</span>
                                                <span><i class="fa fa-door-open me-1"></i>@activeRooms.Count phòng</span>
                                            </div>
                                            <div class="card-body">
                                                <h5 class="mb-2">@ad.Title</h5>
                                                @if (isDiamond)
                                                {
                                                    <span class="badge bg-gradient-diamond animated-gradient me-2"><i class="fa fa-gem me-1"></i>Kim cương</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-gradient-gold animated-gradient me-2"><i class="fa fa-crown me-1"></i>Vàng</span>
                                                }
                                                <div class="mb-2">
                                                    @if (minPrice > 0 && maxPrice > 0)
                                                    {
                                                        <span class="text-success fw-bold">@minPrice.ToString("N0")@(minPrice != maxPrice ? $" - {maxPrice.ToString("N0")}" : "") đ</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Liên hệ giá</span>
                                                    }
                                                </div>
                                                <div class="mt-2 position-relative">
                                                    <div class="ad-content-preview truncate-2">@Html.Raw(ad.Content)</div>
                                                    <div class="text-center mt-1">
                                                        <button class="btn btn-link btn-sm p-0 ad-see-more-btn" type="button" tabindex="-1">Xem thêm</button>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center w-100 mt-3 pt-2 small text-secondary">
                                                    <span><i class="fa fa-calendar-alt me-1"></i>@fakeDate.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
                <!-- Bạc + Đồng: mỗi row 3 col-md-4, trộn chung, ưu tiên bạc lên trước -->
                <div class="mb-5">
                    @{
                        var lowerAds = bacAds.Concat(dongAds).ToList();
                    }
                    @for (int i = 0; i < lowerAds.Count; i += 3)
                    {
                        <div class="row mb-4">
                            @for (int j = i; j < Math.Min(i + 3, lowerAds.Count); j++)
                            {
                                var ad = lowerAds[j];
                                var images = !string.IsNullOrEmpty(ad.ImageUrls) ? ad.ImageUrls.Split(',') : new string[0];
                                var activeRooms = ad.Rooms?.Where(r => r.Status == RentalService.Models.RoomStatus.Active).ToList() ?? new List<RentalService.Models.Room>();
                                var minPrice = activeRooms.Any() ? activeRooms.Min(r => r.Price) : 0;
                                var maxPrice = activeRooms.Any() ? activeRooms.Max(r => r.Price) : 0;
                                var isSilver = ad.PackageType == RentalService.Models.AdPackageType.Bac;
                                var isBronze = ad.PackageType == RentalService.Models.AdPackageType.Dong || ad.PackageType == RentalService.Models.AdPackageType.Free;
                                // --- FAKE LOGIC ---
                                int hash = ad.Id.GetHashCode();
                                int fakeView = 0;
                                DateTime fakeDate = DateTime.Today;
                                if (ad.CreatedAt.Date < DateTime.Today) {
                                    int daysAgo = 1 + Math.Abs(hash % 3); // 1, 2, hoặc 3
                                    fakeDate = DateTime.Today.AddDays(-daysAgo);
                                    int baseView = 0;
                                    if (isSilver) baseView = 120;
                                    else if (isBronze) baseView = 60;
                                    else baseView = 100;
                                    fakeView = baseView + Math.Abs(hash % (baseView / 2)) + ((hash >> 2) % (baseView / 4));
                                }
                                <div class="col-md-4 mb-3">
                                    <a href="@Url.Action("Details", "AdPosts", new { id = ad.Id })" class="ad-card-link">
                                        <div class="card @(isSilver ? "silver-ad-card highlight-silver" : "bronze-ad-card") position-relative">
                                            <div class="@(isSilver ? "silver-img-wrap highlight-silver-img" : "bronze-img-wrap")">
                                                @if (images.Length > 0 && !string.IsNullOrEmpty(images[0]))
                                                {
                                                    <img src="@images[0]" class="@(isSilver ? "silver-img-demo" : "bronze-img-demo") img-fluid" alt="Ad Image" onerror="this.onerror=null;this.src='/images/no-image.png';" />
                                                }
                                                else
                                                {
                                                    <img src="/images/no-image.png" class="@(isSilver ? "silver-img-demo" : "bronze-img-demo") img-fluid" alt="No Image" />
                                                }
                                            </div>
                                            <div class="ad-meta-below-img px-2 py-1">
                                                <span class="me-2"><i class="fa fa-eye me-1"></i>@fakeView</span>
                                                <span><i class="fa fa-door-open me-1"></i>@activeRooms.Count</span>
                                            </div>
                                            <div class="card-body">
                                                <h6 class="mb-2">@ad.Title</h6>
                                                @if (isSilver)
                                                {
                                                    <span class="badge bg-gradient-silver animated-gradient text-dark me-2"><i class="fa fa-medal me-1"></i>Bạc</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-gradient-bronze animated-gradient text-dark me-2"><i class="fa fa-award me-1"></i>Đồng</span>
                                                }
                                                <div class="mb-2">
                                                    @if (minPrice > 0 && maxPrice > 0)
                                                    {
                                                        <span class="text-success fw-bold">@minPrice.ToString("N0")@(minPrice != maxPrice ? $" - {maxPrice.ToString("N0")}" : "") đ</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Liên hệ giá</span>
                                                    }
                                                </div>
                                                <div class="mt-2 position-relative">
                                                    <div class="ad-content-preview truncate-1" style="max-height: 22px; overflow: hidden;">@Html.Raw(ad.Content)</div>
                                                    <div class="text-center mt-1">
                                                        <button class="btn btn-link btn-sm p-0 ad-see-more-btn" type="button" tabindex="-1">Xem thêm</button>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center w-100 mt-3 pt-2 small text-secondary">
                                                    <span><i class="fa fa-calendar-alt me-1"></i>@fakeDate.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-md-3 mb-4">
            <div id="adPostSidebarWrapper">
                @Html.Partial("_AdPostFilterSidebar")
            </div>
        </div>
    </div>
</div>
<!-- Đảm bảo file CSS hiệu ứng động badge-animated-gradient.css được import trong <head> của _Layout.cshtml:
<link rel="stylesheet" href="~/css/badge-animated-gradient.css?v=@DateTime.Now.Ticks" />
Nếu chưa có, hãy thêm vào _Layout.cshtml trước thẻ </head> để tránh cache và đảm bảo hiệu ứng load đúng. -->
<style>
    .ad-meta-top-left {
        position: static;
        display: flex;
        gap: 1.2em;
        background: none;
        border-radius: 0;
        font-size: 0.98em;
        color: #666;
        font-weight: 500;
        box-shadow: none;
        margin-bottom: 0.2em;
        padding-left: 0;
        padding-right: 0;
        padding-top: 0;
        padding-bottom: 0;
    }
    .diamond-ad-card {
        border-radius: 16px;
        min-height: 340px;
        position: relative;
        z-index: 2;
        box-shadow: 0 4px 18px #00bcd455, 0 2px 8px #e9ecef;
    }
    .gold-ad-card {
        border-radius: 16px;
        min-height: 340px;
        position: relative;
        z-index: 1;
        box-shadow: 0 4px 16px #ffd70055, 0 2px 8px #e9ecef;
    }
    .silver-ad-card {
        border-radius: 14px;
        min-height: 140px;
        box-shadow: 0 2px 8px #b0bec522, 0 2px 8px #e9ecef;
    }
    .bronze-ad-card {
        border-radius: 14px;
        min-height: 120px;
        box-shadow: 0 2px 8px #bdbdbd22, 0 2px 8px #e9ecef;
    }
    .diamond-img-wrap {
        width: 100%;
        height: 190px;
        background: linear-gradient(90deg, #e0f7fa 0%, #e3f0ff 100%);
        border-radius: 16px 16px 0 0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 2px solid #00bcd4;
    }
    .diamond-img-demo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        border-radius: inherit;
        display: block;
    }
    .gold-img-wrap {
        width: 100%;
        height: 190px;
        background: linear-gradient(90deg, #fffbe6 0%, #fffde7 100%);
        border-radius: 16px 16px 0 0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        border-bottom: 2px solid #ffd700;
    }
    .silver-img-wrap {
        width: 100%;
        height: 140px; /* tăng từ 100px lên 140px */
        background: #eceff1;
        border-radius: 14px 14px 0 0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .bronze-img-wrap {
        width: 100%;
        height: 140px; /* tăng từ 100px lên 140px */
        background: #f5f5f5;
        border-radius: 14px 14px 0 0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    /* CSS bổ sung cho preview và nút xem thêm */
    .ad-content-preview {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 10; /* tăng từ 3 lên 10 dòng cho thẻ kim cương */
        -webkit-box-orient: vertical;
        min-height: 1.5em;
    }
    .ad-see-more-btn {
        font-size: 0.95em;
        color: #0d6efd;
        text-decoration: underline;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        margin: 0;
    }
    .ad-see-more-btn:focus {
        outline: none;
        box-shadow: none;
    }
    /* CSS bổ sung cho truncate-3 */
    .truncate-3 {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }
    /* CSS bổ sung cho truncate-2 và truncate-1 */
    .truncate-2 {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
    .truncate-1 {
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
    }
    /* CSS bổ sung cho grid ảnh kim cương */
    .diamond-img-grid {
        width: 100%;
    }
    .diamond-img-main {
        width: 100%;
        height: 260px; /* giảm từ 370px xuống 260px */
        background: #e0f7fa;
        border-radius: 16px 16px 0 0;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .diamond-img-main img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 16px 16px 0 0;
    }
    .diamond-img-thumbs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 8px;
        height: 220px;
    }
    .diamond-img-thumb {
        position: relative;
        width: 100%;
        height: 130px; /* tăng từ 104px lên 130px */
        overflow: hidden;
        border-radius: 8px;
        background: #e0f7fa;
    }
    .diamond-img-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 8px;
    }
    .diamond-img-more {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.45);
        color: #fff;
        font-weight: bold;
        font-size: 1.1em;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }
    /* CSS bổ sung cho meta dưới ảnh */
    .ad-meta-below-img {
        display: flex;
        gap: 1.2em;
        background: none;
        border-radius: 0;
        font-size: 0.98em;
        color: #666;
        font-weight: 500;
        box-shadow: none;
        margin-bottom: 0.2em;
        padding-left: 0;
        padding-right: 0;
        padding-top: 0.2em;
        padding-bottom: 0.2em;
        justify-content: flex-start;
    }
    .ad-card-link {
        display: block;
        text-decoration: none;
        color: inherit;
        transition: box-shadow 0.2s, filter 0.2s;
    }
    .ad-card-link:hover .card,
    .ad-card-link:focus .card {
        box-shadow: 0 6px 32px #0dcaf099, 0 2px 8px #e9ecef;
        filter: brightness(0.98);
        border-color: #0d6efd;
    }
    .ad-card-link:active .card {
        filter: brightness(0.95);
    }
    .homepage-hero .cta-box .fs-3 { font-size: 1.5rem !important; }
    .homepage-hero .cta-box .fs-5 { font-size: 1.08rem !important; }
    .homepage-hero h1.display-2 { font-size: 2.2rem !important; }
    .homepage-hero p.lead { font-size: 1.15rem !important; }
    .silver-ad-card.highlight-silver {
        border: 2.5px solid #b0c4de;
        background: linear-gradient(90deg, #f8fafc 0%, #e3eafc 100%);
        box-shadow: 0 4px 16px #b0c4de55, 0 2px 8px #e9ecef;
        position: relative;
        z-index: 1;
    }
    .silver-img_wrap.highlight-silver-img {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(function () {
            var success = '@TempData["ToastSuccess"]';
            var error = '@TempData["ToastError"]';
            var info = '@TempData["ToastInfo"]';
            var warning = '@TempData["ToastWarning"]';
            if (success) toastr.success(success);
            if (error) toastr.error(error);
            if (info) toastr.info(info);
            if (warning) toastr.warning(warning);
        });
    </script>
    <script>
        $(function () {
            function loadNotifications(updateList = true) {
                $.get('@Url.Action("GetNotifications", "Profile")', function (data) {
                    var list = $('#notificationList');
                    var badge = $('#notificationBadge');
                    var unread = data.filter(n => !n.isRead);
                    badge.text(unread.length).toggle(unread.length > 0);
                    if (updateList) {
                        if (unread.length > 0) {
                            list.empty();
                            unread.slice(0, 3).forEach(function (n) {
                                var item = `<div class="dropdown-item fw-bold">
                            <div class='notification-text text-wrap text-break'>${n.title}</div>
                            <div class='notification-text small text-muted text-wrap text-break'>${n.message}</div>
                            <div class='small text-muted'>${n.createdAt}</div>
                        </div>`;
                                list.append(item);
                            });
                        } else {
                            list.html('<div class="text-center p-3 text-muted">Không có thông báo mới</div>');
                        }
                    }
                });
            }
            // Load notifications when dropdown is shown
            $('#notificationDropdown').on('show.bs.dropdown', function () {
                loadNotifications(true);
            });
            // Update badge every 60s, but don't update list unless dropdown is open
            setInterval(function () {
                loadNotifications(false);
            }, 60000);
            // Initial badge load
            loadNotifications(false);
        });
    </script>
    <script>
        // Nút lướt lên đầu trang
        const scrollBtn = document.getElementById('scrollToTopBtn');
        if (scrollBtn) {
            scrollBtn.onclick = function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };
            window.addEventListener('scroll', function () {
                if (window.scrollY > 200) {
                    scrollBtn.style.display = 'block';
                } else {
                    scrollBtn.style.display = 'none';
                }
            });
            scrollBtn.style.display = 'none';
        }
    </script>
    <script>
        // Dropdown hover fix: chỉ áp dụng cho menu chính (me-auto), bỏ qua notification và profile
        $(function () {
            // Hover chỉ cho menu chính
            $('.main-header-bar .navbar-nav.me-auto .nav-item.dropdown').each(function () {
                var $dropdown = $(this);
                var timer;
                $dropdown.on('mouseenter', function () {
                    clearTimeout(timer);
                    $dropdown.addClass('show');
                    $dropdown.find('.dropdown-menu').addClass('show');
                });
                $dropdown.on('mouseleave', function () {
                    timer = setTimeout(function () {
                        $dropdown.removeClass('show');
                        $dropdown.find('.dropdown-menu').removeClass('show');
                    }, 180);
                });
                $dropdown.find('.dropdown-menu').on('mouseenter', function () {
                    clearTimeout(timer);
                    $dropdown.addClass('show');
                    $(this).addClass('show');
                });
                $dropdown.find('.dropdown-menu').on('mouseleave', function () {
                    timer = setTimeout(function () {
                        $dropdown.removeClass('show');
                        $dropdown.find('.dropdown-menu').removeClass('show');
                    }, 180);
                });
            });
            // KHÔNG can thiệp dropdown notification/profile (ms-auto) nữa, để Bootstrap xử lý click mặc định
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_floatingChatbotScript")
    <script src="~/js/badge-animated-gradient.js" asp-append-version="true"></script>
    <script>
        // Ẩn section SEO khi user cuộn gần đến cuối trang (footer), nhưng Googlebot vẫn crawl được
        (function () {
            function isGoogleBot() {
                // Cập nhật danh sách user-agent của Googlebot để nhận diện tốt hơn
                return /googlebot|adsbot-google|mediapartners-google/i.test(navigator.userAgent);
            }

            var seoSection = document.getElementById('seo-footer-content'); // SỬA LẠI ID CHO ĐÚNG

            // Nếu không phải Googlebot và tìm thấy section SEO thì mới chạy script ẩn
            if (seoSection && !isGoogleBot()) {
                var footer = document.querySelector('.footer');

                // Hàm kiểm tra và ẩn section
                function checkAndHideSeoSection() {
                    if (!footer) return;

                    var footerRect = footer.getBoundingClientRect();
                    var windowHeight = window.innerHeight || document.documentElement.clientHeight;

                    // Nếu phần đầu của footer bắt đầu xuất hiện trong viewport (người dùng cuộn xuống gần cuối)
                    // thì ẩn section SEO đi để tránh bất kỳ ảnh hưởng nào đến layout.
                    if (footerRect.top < windowHeight) {
                        seoSection.style.display = 'none';
                    } else {
                        // Khi cuộn lên lại, hiện nó ra (dù nó vẫn vô hình với mắt thường)
                        // để đảm bảo logic hoạt động nếu người dùng cuộn lên xuống nhiều lần.
                        seoSection.style.display = 'block';
                    }
                }

                // Chạy hàm khi cuộn trang
                window.addEventListener('scroll', checkAndHideSeoSection);
                // Chạy hàm khi tải trang xong
                window.addEventListener('load', checkAndHideSeoSection);
            }
        })();
    </script>
</body>

</html>
